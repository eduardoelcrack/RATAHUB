local function getWhitelistPlayerNames()
    local names = {}
    pcall(function()
        for _, p in ipairs(Services.Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(names, p.Name)
            end
        end
    end)
    if #names == 0 then table.insert(names, "Nadie") end
    table.sort(names)
    return names
end

local dropdownWhitelistTarget = secWhitelistSync:dropdown({
    name = "Whitelist Target",
    flag = "esp_whitelist_target",
    width = 110,
    multi = true,
    items = getWhitelistPlayerNames(),
    default = {}
})

pcall(function()
    Services.Players.PlayerAdded:Connect(function()
        if dropdownWhitelistTarget and dropdownWhitelistTarget.refresh_options then
            dropdownWhitelistTarget.refresh_options(getWhitelistPlayerNames())
        end
    end)
    Services.Players.PlayerRemoving:Connect(function()
        if dropdownWhitelistTarget and dropdownWhitelistTarget.refresh_options then
            dropdownWhitelistTarget.refresh_options(getWhitelistPlayerNames())
        end
    end)
end)

