        -- CreateSlider
        function sectionWrapper:CreateSlider(cfg)
            cfg = cfg or {}
            local range = cfg.Range or {0, 100}
            local step  = cfg.Increment or 1

            local borosSlider = self._borosSection:slider({
                name     = cfg.Name or "Slider",
                min      = range[1],
                max      = range[2],
                interval = step,
                default  = cfg.CurrentValue or range[1],
                suffix   = cfg.Suffix or "",
                callback = function(value)
                    if cfg.Callback then pcall(cfg.Callback, value) end
                end,
            })

            local wrapper = {
                _boros = borosSlider,
                Set = function(_, v) borosSlider.set(v) end,
                Get = function(_) return borosSlider.value end,
            }
            self._controls[cfg.Name or "slider"] = wrapper
            return wrapper
        end

        -- CreateDropdown
        function sectionWrapper:CreateDropdown(cfg)
            cfg = cfg or {}
            local options = cfg.Options or {""}
            local defaultVal = cfg.CurrentOption or options[1]
            local isMulti = cfg.MultipleOptions or cfg.MultiSelect or false

            -- Normalizar default para multi
            if isMulti then
                if type(defaultVal) == "string" then
                    defaultVal = { defaultVal }
                elseif type(defaultVal) ~= "table" then
                    defaultVal = {}
                end
            end

            local borosDropdown = self._borosSection:dropdown({
                name     = cfg.Name or "Dropdown",
                items    = options,
                default  = defaultVal,
                multi    = isMulti,
                callback = function(value)
                    if cfg.Callback then pcall(cfg.Callback, value) end
                end,
            })

            local wrapper = {
                _boros = borosDropdown,
                Set = function(_, v) borosDropdown.set(v) end,
                Get = function(_) return borosDropdown.multi_items or borosDropdown.value end,
                Refresh = function(_, newOptions, reset)
                    borosDropdown.refresh_options(newOptions or {})
                    if reset and newOptions and newOptions[1] then
                        borosDropdown.set(newOptions[1])
                    end
                end,
            }
            self._controls[cfg.Name or "dropdown"] = wrapper
            return wrapper
