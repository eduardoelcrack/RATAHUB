-- 2. WALKSPEED LOGIC
-- -----------------------------------------------------------------
local function StopWalkSpeed()
    if Runtime.WalkSpeed.loop then
        Runtime.WalkSpeed.loop:Disconnect()
        Runtime.WalkSpeed.loop = nil
    end
    Runtime.WalkSpeed.active = false
    local hum = getHumanoid()
    if hum then
        local orig = Runtime.WalkSpeed.original or 16
        if orig > 100 then orig = 16 end
        hum.WalkSpeed = orig
        Runtime.WalkSpeed.original = nil
    end
end

local function StartWalkSpeed()
    if Runtime.WalkSpeed.loop then return end
    local hum = getHumanoid()
    if hum then
        if not Runtime.WalkSpeed.original or Runtime.WalkSpeed.original > 100 then
            Runtime.WalkSpeed.original = hum.WalkSpeed
        end
    end

    Runtime.WalkSpeed.active = true
    Runtime.WalkSpeed.loop = RunService.Heartbeat:Connect(function(dt)
        if not Config.Movement.WalkSpeedEnabled or not Runtime.WalkSpeed.active then
            StopWalkSpeed()
            return
        end
        local hum = getHumanoid()
        local char = LocalPlayer and LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum then return end

        local desired = Config.Movement.WalkSpeed or 16
        local moveDir = hum.MoveDirection
        local method = Config.Movement.WalkSpeedMethod or "Normal"

        if method == "Normal" then
            hum.WalkSpeed = desired
        elseif method == "AssemblyLinearVelocity" and root then
            if moveDir.Magnitude > 0 then
                root.AssemblyLinearVelocity = Vector3.new(moveDir.X * desired, root.AssemblyLinearVelocity.Y, moveDir.Z * desired)
            end
        elseif method == "CFrame" and root then
            if moveDir.Magnitude > 0 then
                root.CFrame = root.CFrame + (moveDir * desired * dt)
            end
        end
    end)
end

local function ToggleWalkSpeed(enabled)
    Config.Movement.WalkSpeedEnabled = enabled
    if enabled then
        StartWalkSpeed()
    else
        StopWalkSpeed()
    end
end

