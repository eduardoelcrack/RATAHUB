        -- CreateLabel
        function sectionWrapper:CreateLabel(cfg)
            local text = type(cfg) == "table" and cfg.Text or cfg
            local borosLabel = self._borosSection:label({
                name    = tostring(text or "Label"),
                wrapped = true,
            })
            return {
                _boros = borosLabel,
                Set = function(_, t) borosLabel.set(t) end,
                Get = function(_) return borosLabel.items.name.Text end,
