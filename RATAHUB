-- -----------------------------------------------------------------
-- 7. HITBOX EXPANDER LOGIC
-- -----------------------------------------------------------------
local function RestoreHitboxes()
    if Runtime.Hitbox.loop then
        Runtime.Hitbox.loop:Disconnect()
        Runtime.Hitbox.loop = nil
    end
    for plr, origSize in pairs(Runtime.Hitbox.origs) do
        if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            plr.Character.HumanoidRootPart.Size = origSize
            plr.Character.HumanoidRootPart.Transparency = 1
        end
    end
    table.clear(Runtime.Hitbox.origs)
end

local function StartHitboxes()
    if Runtime.Hitbox.loop then return end
    Runtime.Hitbox.loop = RunService.RenderStepped:Connect(function()
        if not Config.Player.HitboxExpander then
            RestoreHitboxes()
            return
        end
        local sizeVal = Config.Player.HitboxSize or 10
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if not Runtime.Hitbox.origs[plr] then
                    Runtime.Hitbox.origs[plr] = hrp.Size
                end
                hrp.Size = Vector3.new(sizeVal, sizeVal, sizeVal)
                hrp.Transparency = 0.7
                hrp.CanCollide = false
            end
        end
    end)
end

local function ToggleHitbox(enabled)
    Config.Player.HitboxExpander = enabled
    if enabled then
        StartHitboxes()
    else
        RestoreHitboxes()
    end
end

