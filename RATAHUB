function Features.RestoreHitbox(plr)
    if not plr then return end
    local data = Runtime.Hitbox.origs[plr]
    if not data then return end

    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = data.Size
        hrp.Transparency = data.Transparency
        hrp.CanCollide = data.CanCollide
        if data.Material then hrp.Material = data.Material end
        if data.Color then hrp.Color = data.Color end
        pcall(function() hrp:SetAttribute("IsExpandedHitbox", nil) end)
    end
    Runtime.Hitbox.origs[plr] = nil
end

function Features.RestoreHitboxes()
    for plr in pairs(Runtime.Hitbox.origs) do
        Features.RestoreHitbox(plr)
    end
    table.clear(Runtime.Hitbox.origs)
end

function Features.UpdateHitboxes()
    local isEnabled = Config.Main.Player.HitboxExpander
    local sizeVal   = Config.Main.Player.HitboxSize or 5
    local mode      = Config.Main.Player.HitboxWhitelistMode or "Disabled"
    local targetSel = Config.Main.Player.HitboxTarget

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local char = p.Character
            local hum  = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local shouldExpand = isEnabled and Features.IsWhitelisted(p, mode, targetSel)
                if shouldExpand then
                    local stored = Runtime.Hitbox.origs[p]
                    if not stored or stored.Char ~= char or stored.Root ~= root then
                        Runtime.Hitbox.origs[p] = {
                            Char = char,
                            Root = root,
                            Size = root.Size,
                            Transparency = root.Transparency,
                            CanCollide = root.CanCollide,
                            Material = root.Material,
                            Color = root.Color,
                        }
                    end
                    local targetSize = Vector3.new(sizeVal, sizeVal, sizeVal)
                    if root.Size ~= targetSize or root.Transparency ~= 0.5 then
                        root.Size = targetSize
                        root.Transparency = 0.5
                        root.Material = Enum.Material.Neon
                        root.Color = Color3.fromRGB(175, 25, 255)
                        root.CanCollide = false
                        pcall(function() root:SetAttribute("IsExpandedHitbox", true) end)
                    end
                else
                    if Runtime.Hitbox.origs[p] then
                        Features.RestoreHitbox(p)
                    end
                end
            else
                if Runtime.Hitbox.origs[p] then
                    Features.RestoreHitbox(p)
                end
            end
        end
    end
end

function Features.ToggleHitboxLoop(enable)
    if Runtime.Hitbox.loop then
        pcall(function() task.cancel(Runtime.Hitbox.loop) end)
        Runtime.Hitbox.loop = nil
    end
    if not enable then
        Features.RestoreHitboxes()
        return
    end
    Runtime.Hitbox.loop = task.spawn(function()
        while Config.Main.Player.HitboxExpander do
            Features.UpdateHitboxes()
            task.wait(0.1)
        end
        Features.RestoreHitboxes()
        Runtime.Hitbox.loop = nil
    end)
end

