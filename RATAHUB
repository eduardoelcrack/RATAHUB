function Features.SpawnDamageIndicator(targetChar, damageAmount, hitSource)
    local espCfg = Config.ESP
    if not espCfg.DamageIndicator then return end
    if not targetChar then return end

    local part = targetChar:FindFirstChild("Head")
        or targetChar:FindFirstChild("HumanoidRootPart")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChild("UpperTorso")
        or targetChar:FindFirstChildWhichIsA("BasePart")
    if not part then return end

    local parentContainer = nil
    if gethui then pcall(function() parentContainer = gethui() end) end
    if not parentContainer then
        parentContainer = game:GetService("CoreGui"):FindFirstChild("RATAHUB_HUD")
            or hudGui
            or player:FindFirstChild("PlayerGui")
            or workspace
    end

    activeIndicators[targetChar] = activeIndicators[targetChar] or {}
    local list = activeIndicators[targetChar]
    for i = #list, 1, -1 do
        local item = list[i]
        if item and item.bb and item.bb.Parent then
            item.currentOffset = item.currentOffset + Vector3.new(0, 1.2, 0)
            TweenService:Create(
                item.bb,
                TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { StudsOffset = item.currentOffset }
            ):Play()
        else
            table.remove(list, i)
        end
    end

    local bb = Instance.new("BillboardGui")
    bb.Name = "RATAHUB_DamageIndicator"
    bb.Adornee = part
    bb.Size = UDim2.fromOffset(140, 42)
    bb.AlwaysOnTop = true
    bb.ResetOnSpawn = false
    bb.ClipsDescendants = false

    local spreadX = (math.random(-12, 12) / 10)
    local baseOffsetY = 2.2
    local initialOffset = Vector3.new(spreadX, baseOffsetY, 0)
    bb.StudsOffset = initialOffset
    bb.Parent = parentContainer

    local indicatorData = { bb = bb, currentOffset = initialOffset }
    table.insert(list, indicatorData)

    local chosenColor = DAMAGE_INDICATOR_COLORS[espCfg.DamageIndicatorColor] or Color3.fromRGB(255, 68, 68)
    local isCrit = (espCfg.DamageIndicatorCrit ~= false) and (damageAmount >= 50)

    local label = Instance.new("TextLabel")
    label.Name = "DamageLabel"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = tonumber(espCfg.DamageIndicatorSize) or 16
    label.TextColor3 = isCrit and Color3.fromRGB(255, 215, 0) or chosenColor
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(15, 15, 20)
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextYAlignment = Enum.TextYAlignment.Center

    local tag = ""
    if espCfg.DamageIndicatorShowSource and hitSource and hitSource ~= "" then
        tag = " [" .. tostring(hitSource) .. "]"
    end
    local roundedDmg = math.floor(damageAmount + 0.5)
    label.Text = string.format("-%d%s", roundedDmg, tag)
    label.ZIndex = 20
    label.Parent = bb

    local stroke_inst = Instance.new("UIStroke")
    stroke_inst.Thickness = 1.6
    stroke_inst.Color = Color3.fromRGB(10, 12, 16)
    stroke_inst.Transparency = 0.1
    stroke_inst.Parent = label

    local scale = Instance.new("UIScale")
    scale.Scale = 0.4
    scale.Parent = label

    local pop = TweenService:Create(
        scale,
        TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Scale = isCrit and 1.4 or 1.2 }
    )
    pop:Play()

    task.delay(0.12, function()
        if scale and scale.Parent then
            TweenService:Create(
                scale,
                TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Scale = isCrit and 1.15 or 1.0 }
            ):Play()
        end
    end)

    local duration = math.clamp(tonumber(espCfg.DamageIndicatorDuration) or 1.0, 0.4, 4.0)
    local floatDistance = 2.8
    local targetOffset = indicatorData.currentOffset + Vector3.new((math.random(-4, 4) / 10), floatDistance, 0)
    indicatorData.currentOffset = targetOffset

    local floatTween = TweenService:Create(
        bb,
        TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { StudsOffset = targetOffset }
    )
    floatTween:Play()

    task.delay(duration * 0.45, function()
        if label and label.Parent then
            local fadeTime = duration * 0.55
            TweenService:Create(
                label,
                TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { TextTransparency = 1, TextStrokeTransparency = 1 }
            ):Play()
            if stroke_inst and stroke_inst.Parent then
                TweenService:Create(
                    stroke_inst,
                    TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    { Transparency = 1 }
                ):Play()
            end
        end
    end)

    task.delay(duration + 0.1, function()
        pcall(function() bb:Destroy() end)
        for i, v in ipairs(list) do
            if v == indicatorData then
                table.remove(list, i)
                break
            end
        end
    end)
end

function Features.TrackPlayerDamage(p)
    if not p or p == player then return end

    local function hookChar(char)
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 3) or char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local lastHealth = hum.Health
        local conn
        conn = hum.HealthChanged:Connect(function(newHealth)
            if not hum or not hum.Parent then
                if conn then conn:Disconnect() end
                return
            end

            if newHealth < lastHealth and lastHealth > 0 then
                local dmg = lastHealth - newHealth
                lastHealth = newHealth

                if dmg > 0 and dmg < 100000 then
                    local espCfg = Config.ESP
                    if espCfg.DamageIndicator then
                        local mode = espCfg.DamageIndicatorMode or "Only My Targets (Aimlock/Silent/Trigger)"
                        local isAimlockTarget = (Runtime.Aimlock and Runtime.Aimlock.locked and Runtime.Aimlock.currentTarget == p)
                        local isSilentTarget  = (SilentAim and SilentAim.LockedTarget == p)
                            or (DaHoodSilent and DaHoodSilent.LockedTarget == p)
                        local isTriggerbotShooting = (Runtime.Triggerbot and Runtime.Triggerbot.isShooting)

                        local hitSource = ""
                        if isAimlockTarget then hitSource = "Aimlock"
                        elseif isSilentTarget then hitSource = "Silent"
                        elseif isTriggerbotShooting then hitSource = "Triggerbot" end

                        local shouldShow = false
                        if mode == "Only My Targets (Aimlock/Silent/Trigger)" or mode == "Solo Mis Objetivos (Aimlock/Silent/Trigger)" then
                            shouldShow = (isAimlockTarget or isSilentTarget or (isTriggerbotShooting and not Features.IsSameTeam(p)))
                        elseif mode == "All Enemies" or mode == "Todos los Enemigos" then
                            shouldShow = not Features.IsSameTeam(p)
                                and Features.IsWhitelisted(p, espCfg.WhitelistMode, espCfg.WhitelistTarget)
                        else
                            shouldShow = true
                        end

                        if shouldShow then
                            Features.SpawnDamageIndicator(char, dmg, hitSource)
                            if Config.Sounds and Config.Sounds.HitSound and Config.Sounds.HitShootSound then
                                Features.PlaySound(Config.Sounds.HitShootSound)
                            end
                        end
                    end
                end
            else
                lastHealth = newHealth
            end
        end)

        table.insert(Runtime._GlobalConnections, conn)
    end

    if p.Character then task.spawn(hookChar, p.Character) end
    local charConn = p.CharacterAdded:Connect(function(c) task.spawn(hookChar, c) end)
    table.insert(Runtime._GlobalConnections, charConn)
end

function Features.InitDamageIndicator()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then Features.TrackPlayerDamage(p) end
    end
    local playerAddedConn = Players.PlayerAdded:Connect(function(p)
        if p ~= player then
            task.wait(0.2)
            Features.TrackPlayerDamage(p)
        end
    end)
    table.insert(Runtime._GlobalConnections, playerAddedConn)
end

