function Features.StartHotkeys()
    if Runtime.Hotkeys.conn then return end
    Runtime.Hotkeys.conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if UserInputService:GetFocusedTextBox() then return end

        local keyName = nil
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
            keyName = input.KeyCode.Name
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            keyName = "MouseButton1"
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            keyName = "MouseButton2"
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
            keyName = "MouseButton3"
        end
        if not keyName then return end

        local function matchesKey(cfgKey)
            if not cfgKey or cfgKey == "None" or cfgKey == "" then return false end
            if typeof(cfgKey) == "EnumItem" then
                return cfgKey.Name == keyName
            end
            return tostring(cfgKey) == keyName
        end

        if matchesKey(Config.Main.Movement.FlyKeybind) then
            Features.ToggleFlyActive()
        elseif matchesKey(Config.Main.Movement.WalkSpeedKeybind) then
            Features.ToggleWalkSpeed()
        elseif matchesKey(Config.Main.Movement.InfiniteJumpKeybind) then
            Features.ToggleInfiniteJumpActive()
        elseif matchesKey(Config.Main.Movement.NoclipKeybind) then
            Features.ToggleNoclipActive()
        elseif matchesKey(Config.Aimlock.Keybind) then
            Features.ToggleAimlockLock()
        elseif matchesKey(Config.Triggerbot.Keybind) then
            Features.ToggleTriggerbotActive()
        elseif matchesKey(Config.ESP.HighlightKeybind) then
            if not Config.ESP.Highlight then return end
            Runtime.ESP.highlightActive = not Runtime.ESP.highlightActive
            Features.UpdateESP()
            RATAHUB:Notify({
                Title = "ESP Highlight",
                Content = Runtime.ESP.highlightActive and "Active" or "Paused",
                Duration = 1.2
            })
        elseif matchesKey(Config.ESP.NamesKeybind) then
            if not Config.ESP.Names then return end
            Runtime.ESP.namesActive = not Runtime.ESP.namesActive
            Features.UpdateESP()
            RATAHUB:Notify({
                Title = "ESP Names",
                Content = Runtime.ESP.namesActive and "Active" or "Paused",
                Duration = 1.2
            })
        elseif matchesKey(Config.ESP.TracersKeybind) then
            if not Config.ESP.Tracers then return end
            Runtime.ESP.tracersActive = not Runtime.ESP.tracersActive
            Features.UpdateESP()
            RATAHUB:Notify({
                Title = "ESP Tracers",
                Content = Runtime.ESP.tracersActive and "Active" or "Paused",
                Duration = 1.2
            })
        end
    end)
end

