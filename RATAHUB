function Features.StartWalkSpeed()
    if Runtime.WalkSpeed.loop then return end
    local hum = getHumanoid()
    if hum and not Runtime.WalkSpeed.original then
        Runtime.WalkSpeed.original = hum.WalkSpeed
    end

    local method = Config.Main.Movement.WalkSpeedMethod or "Normal"
    Runtime.WalkSpeed.method = method
    Runtime.WalkSpeed.active = true
    Runtime.WalkSpeed.loop = RunService.Heartbeat:Connect(function(dt)
        if not Config.Main.Movement.WalkSpeedEnabled or not Runtime.WalkSpeed.active then
            Features.StopWalkSpeed()
            return
        end
        local hum  = getHumanoid()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum then return end

        local desired = Config.Main.Movement.WalkSpeed or 16
        local moveDir = hum.MoveDirection

        if method == "Normal" then
            hum.WalkSpeed = desired
        elseif method == "AssemblyLinearVelocity" and root then
            if moveDir.Magnitude > 0 then
                root.AssemblyLinearVelocity = Vector3.new(
                    moveDir.X * desired,
                    root.AssemblyLinearVelocity.Y,
                    moveDir.Z * desired
                )
            end
        elseif method == "CFrame" and root then
            if moveDir.Magnitude > 0 then
                root.CFrame = root.CFrame + (moveDir * desired * dt)
            end
        end
    end)
end

function Features.StopWalkSpeed()
    if Runtime.WalkSpeed.loop then
        Runtime.WalkSpeed.loop:Disconnect()
        Runtime.WalkSpeed.loop = nil
    end
    Runtime.WalkSpeed.active = false
    local hum = getHumanoid()
    if hum and Runtime.WalkSpeed.original then
        hum.WalkSpeed = Runtime.WalkSpeed.original
        Runtime.WalkSpeed.original = nil
    end
end

function Features.SetWalkSpeedMaster(enabled)
