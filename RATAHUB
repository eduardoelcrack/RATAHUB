--=====================================================================
-- DYNAMIC HELPERS: WHITELIST / TEAMS / FRIENDS
--=====================================================================
function Features.IsAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    return (hum and hum.Health > 0) or false
end

local FriendsCache = {}

local function CheckPlayerIsFriend(p)
    if not p or p == player then return false end
    local s1, status = pcall(function() return player:GetFriendStatus(p) end)
    if s1 and (status == Enum.FriendStatus.Friend or status == Enum.FriendStatus.FriendRequestSent) then
        return true
    end
    local s2, isF = pcall(function() return player:IsFriendsWith(p.UserId) end)
    if s2 and isF then return true end
    local s3, isF2 = pcall(function() return p:IsFriendsWith(player.UserId) end)
    if s3 and isF2 then return true end
    return false
end

function Features.RefreshAllFriends()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            task.spawn(function()
                local isF = CheckPlayerIsFriend(p)
                FriendsCache[p] = isF
                FriendsCache[p.UserId] = isF
                FriendsCache[p.Name] = isF
            end)
        end
    end
end

local function CacheFriendStatus(p)
    if not p or p == player then return end
    task.spawn(function()
        local isF = CheckPlayerIsFriend(p)
        FriendsCache[p] = isF
        FriendsCache[p.UserId] = isF
        FriendsCache[p.Name] = isF
    end)
end

for _, p in ipairs(Players:GetPlayers()) do CacheFriendStatus(p) end

table.insert(Runtime._GlobalConnections, Players.PlayerAdded:Connect(function(p) CacheFriendStatus(p) end))
table.insert(Runtime._GlobalConnections, Players.PlayerRemoving:Connect(function(p)
    FriendsCache[p] = nil
    FriendsCache[p.UserId] = nil
    FriendsCache[p.Name] = nil
end))

pcall(function()
    table.insert(Runtime._GlobalConnections, player.FriendStatusChanged:Connect(function(otherPlayer, friendStatus)
        local isF = (friendStatus == Enum.FriendStatus.Friend or friendStatus == Enum.FriendStatus.FriendRequestSent)
        FriendsCache[otherPlayer] = isF
        FriendsCache[otherPlayer.UserId] = isF
        FriendsCache[otherPlayer.Name] = isF
    end))
end)

function Features.IsFriend(targetPlayer)
    if not targetPlayer or targetPlayer == player then return false end
    if FriendsCache[targetPlayer] ~= nil then return FriendsCache[targetPlayer] end
    if FriendsCache[targetPlayer.UserId] ~= nil then return FriendsCache[targetPlayer.UserId] end
    if FriendsCache[targetPlayer.Name] ~= nil then return FriendsCache[targetPlayer.Name] end
    CacheFriendStatus(targetPlayer)
    return false
end

function Features.IsTeamIgnored(targetPlayer, ignoredTeams)
    if not targetPlayer or not targetPlayer.Team then return false end
    local teamName = targetPlayer.Team.Name
    if type(ignoredTeams) == "table" then
        if ignoredTeams[teamName] == true then return true end
        for k, v in pairs(ignoredTeams) do
            if v == teamName or (k == teamName and v == true) then return true end
        end
    elseif type(ignoredTeams) == "string" and ignoredTeams ~= "" and ignoredTeams ~= "None" and ignoredTeams ~= "Ninguno" then
        return ignoredTeams == teamName
    end
    return false
end

function Features.IsWhitelisted(targetPlayer, mode, target)
    if not targetPlayer or targetPlayer == player then return false end
    if not mode or mode == "Disabled" then return true end

    local name = targetPlayer.Name
    local isSelected = false
    local targetObj = target
    if (not targetObj or (type(targetObj) == "table" and next(targetObj) == nil)) and GlobalWhitelistTable then
        targetObj = GlobalWhitelistTable
    end

    if type(targetObj) == "table" then
        if targetObj[name] == true then
            isSelected = true
        else
            for k, v in pairs(targetObj) do
                if v == name or (k == name and v == true) then
                    isSelected = true
                    break
                end
            end
        end
    elseif type(targetObj) == "string" and targetObj ~= "" and targetObj ~= "None" and targetObj ~= "Nadie" then
        isSelected = (targetObj == name or targetObj == "All" or targetObj == "Todos")
    end

    if mode == "Only Whitelist" then return isSelected end
    if mode == "Ignore Whitelist" then return not isSelected end
    return true
end

function Features.IsSameTeam(p)
    if not p or p == player then return true end
    if p.Team and player.Team and p.Team == player.Team then return true end
    return false
end

--=====================================================================
-- ESP COLORS / FILTERS
--=====================================================================
function Features.IsPlayerValidESP(targetPlayer)
    if not targetPlayer or targetPlayer == player then return false end
    local espCfg = Config.ESP

    local isFriend = Features.IsFriend(targetPlayer)
    if espCfg.FriendCheck and isFriend then return true end

    if espCfg.WhitelistMode == "Only Whitelist" then
        return Features.IsWhitelisted(targetPlayer, "Only Whitelist", espCfg.WhitelistTarget)
    end

    if not Features.IsWhitelisted(targetPlayer, espCfg.WhitelistMode, espCfg.WhitelistTarget) then
        return false
    end

    if espCfg.TeamCheck and Features.IsSameTeam(targetPlayer) then return false end
    if Features.IsTeamIgnored(targetPlayer, espCfg.IgnoreTeams) then return false end
    return true
end

function Features.GetESPColor(targetPlayer)
    local espCfg = Config.ESP
    if espCfg.FriendCheck and Features.IsFriend(targetPlayer) then
        return Color3.fromRGB(0, 255, 120)
    end
    if espCfg.RainbowESP or espCfg.Rainbow then
        return Color3.fromHSV((tick() % 4) / 4, 1, 1)
    end
    if espCfg.TeamColorHighlight and targetPlayer.Team and targetPlayer.TeamColor then
        return targetPlayer.TeamColor.Color
    end
    return COLOR_MAP[espCfg.HighlightColor] or COLOR_MAP["Purple"]
end

function Features.GetESPTextColor(targetPlayer)
    local espCfg = Config.ESP
    if espCfg.FriendCheck and Features.IsFriend(targetPlayer) then
        return Color3.fromRGB(0, 255, 120)
    end
    if espCfg.RainbowESP or espCfg.Rainbow then
        return Color3.fromHSV((tick() % 4) / 4, 1, 1)
    end
    return Color3.fromRGB(255, 255, 255)
end

function Features.GetTracerColor(targetPlayer)
    local espCfg = Config.ESP
    if espCfg.FriendCheck and Features.IsFriend(targetPlayer) then
        return Color3.fromRGB(0, 255, 120)
    end
    if espCfg.RainbowESP or espCfg.Rainbow then
        return Color3.fromHSV((tick() % 4) / 4, 1, 1)
    end
    if espCfg.TeamColorTracers and targetPlayer.Team and targetPlayer.TeamColor then
        return targetPlayer.TeamColor.Color
    end
    return Color3.fromRGB(255, 0, 0)
end

--=====================================================================
-- ESP MODULE
--=====================================================================
function Features.UpdateESP()
    local espCfg = Config.ESP
    if espCfg.Master == false then
        if Runtime.ESP.loop then
            Runtime.ESP.loop:Disconnect()
            Runtime.ESP.loop = nil
        end
        for _, entry in pairs(Runtime.ESP.objects) do
            if entry.Highlight then entry.Highlight.Enabled = false end
            if entry.Billboard then entry.Billboard.Enabled = false end
            if entry.Tracer then entry.Tracer.Visible = false end
        end
        return
    end

    local anyEnabled = (espCfg.Highlight and Runtime.ESP.highlightActive)
        or (espCfg.Names and Runtime.ESP.namesActive)
        or (espCfg.Distance)
        or (espCfg.HealthBar)
        or (espCfg.Weapon)
        or (espCfg.Tracers and Runtime.ESP.tracersActive)

    if not anyEnabled then
        if Runtime.ESP.loop then
            Runtime.ESP.loop:Disconnect()
            Runtime.ESP.loop = nil
        end
        for _, entry in pairs(Runtime.ESP.objects) do
            if entry.Highlight then entry.Highlight.Enabled = false end
            if entry.Billboard then entry.Billboard.Enabled = false end
            if entry.Tracer then entry.Tracer.Visible = false end
        end
        return
    end

    if not Runtime.ESP.container then
        local f = Instance.new("Folder")
        f.Name = "RATAHUB_ESP"
        f.Parent = workspace
        Runtime.ESP.container = f
    end

    if not Runtime.ESP.loop then
        Runtime.ESP.loop = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            if not cam then return end

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    local char = p.Character
                    local hum  = char:FindFirstChildOfClass("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local valid = Features.IsPlayerValidESP(p)

                    local entry = Runtime.ESP.objects[p]
                    if not entry then
                        entry = {}
                        Runtime.ESP.objects[p] = entry
                    end

                    local highlightColor = Features.GetESPColor(p)
                    local textColor      = Features.GetESPTextColor(p)
                    local tracerColor    = Features.GetTracerColor(p)

                    -- Highlight
                    if espCfg.Highlight and Runtime.ESP.highlightActive and valid and hum and hum.Health > 0 then
                        if not entry.Highlight or entry.Highlight.Parent ~= char then
                            if entry.Highlight then entry.Highlight:Destroy() end
                            local h = Instance.new("Highlight")
                            h.Name = "ESPHighlight"
                            h.Adornee = char
                            h.FillTransparency = 0.5
                            h.OutlineTransparency = 0
                            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            h.Parent = char
                            entry.Highlight = h
                        end
                        entry.Highlight.FillColor = highlightColor
                        entry.Highlight.OutlineColor = highlightColor
                        entry.Highlight.Enabled = true
                    elseif entry.Highlight then
                        entry.Highlight.Enabled = false
                    end

                    -- Billboard
                    local showTextOrBar = ((espCfg.Names and Runtime.ESP.namesActive)
                        or espCfg.Distance or espCfg.Weapon or espCfg.HealthBar)
                        and valid and hum and hum.Health > 0 and root

                    if showTextOrBar then
                        if not entry.Billboard then
                            local b = Instance.new("BillboardGui")
                            b.Name = "ESP_Billboard"
                            b.Size = UDim2.new(0, 260, 0, 90)
                            b.AlwaysOnTop = true
                            b.ResetOnSpawn = false
                            b.ClipsDescendants = false

                            local layout = Instance.new("UIListLayout")
                            layout.FillDirection = Enum.FillDirection.Vertical
                            layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                            layout.VerticalAlignment = Enum.VerticalAlignment.Center
                            layout.Padding = UDim.new(0, 2)
                            layout.SortOrder = Enum.SortOrder.LayoutOrder
                            layout.Parent = b

                            local l = Instance.new("TextLabel")
                            l.Name = "Tag"
                            l.Size = UDim2.new(1, 0, 0, 0)
                            l.AutomaticSize = Enum.AutomaticSize.Y
                            l.BackgroundTransparency = 1
                            l.Font = FONT_BOLD
                            l.TextStrokeTransparency = 0.3
                            l.TextStrokeColor3 = Color3.new(0, 0, 0)
                            l.TextXAlignment = Enum.TextXAlignment.Center
                            l.TextYAlignment = Enum.TextYAlignment.Center
                            l.LayoutOrder = 1
                            l.Parent = b

                            local hpBg = Instance.new("Frame")
                            hpBg.Name = "HealthBarBg"
                            hpBg.BackgroundColor3 = Color3.fromRGB(185, 45, 45)
                            hpBg.BorderSizePixel = 0
                            hpBg.LayoutOrder = 2
                            hpBg.Parent = b
                            corner(3, hpBg)

                            local hpFill = Instance.new("Frame")
                            hpFill.Name = "HealthBarFill"
                            hpFill.BackgroundColor3 = Color3.fromRGB(65, 205, 95)
                            hpFill.BorderSizePixel = 0
                            hpFill.Size = UDim2.new(1, 0, 1, 0)
                            hpFill.Parent = hpBg
                            corner(3, hpFill)

                            b.Parent = Runtime.ESP.container
                            entry.Billboard     = b
                            entry.Label         = l
                            entry.HealthBarBg   = hpBg
                            entry.HealthBarFill = hpFill
                        end

                        entry.Billboard.Adornee = root
                        entry.Billboard.StudsOffset = Vector3.new(espCfg.OffsetX, 2.5 + espCfg.OffsetY, 0)
                        entry.Billboard.Enabled = true

                        local textLines = {}
                        if espCfg.Names and Runtime.ESP.namesActive then
                            table.insert(textLines, p.DisplayName)
                        end
                        if espCfg.Distance then
                            local dist = math.floor((cam.CFrame.Position - root.Position).Magnitude)
                            table.insert(textLines, tostring(dist) .. " studs")
                        end
                        if espCfg.Weapon then
                            local wep = getEquippedWeapon(p)
                            if wep and wep ~= "" then
                                table.insert(textLines, tostring(wep))
                            end
                        end

                        if #textLines > 0 then
                            entry.Label.Text = table.concat(textLines, "\n")
                            entry.Label.TextSize = espCfg.TextSize
                            entry.Label.TextColor3 = textColor
                            entry.Label.Visible = true
                        else
                            entry.Label.Text = ""
                            entry.Label.Visible = false
                        end

                        if espCfg.HealthBar then
                            local hp    = math.max(0, hum.Health)
                            local maxHp = math.max(1, hum.MaxHealth)
                            local hpRatio = math.clamp(hp / maxHp, 0, 1)
                            local barW = math.clamp(espCfg.TextSize * 4.5, 45, 120)
                            local barH = math.clamp(espCfg.TextSize * 0.35, 4, 10)
                            entry.HealthBarBg.Size = UDim2.fromOffset(barW, barH)
                            entry.HealthBarFill.Size = UDim2.new(hpRatio, 0, 1, 0)
                            entry.HealthBarBg.Visible = true
                        else
                            if entry.HealthBarBg then entry.HealthBarBg.Visible = false end
                        end
                    elseif entry.Billboard then
                        entry.Billboard.Enabled = false
                    end

                    -- Tracers
                    if espCfg.Tracers and Runtime.ESP.tracersActive and valid and hum and hum.Health > 0 and root and Drawing then
                        if not entry.Tracer then
                            local line = Drawing.new("Line")
                            line.Thickness = 1.5
                            line.Transparency = 1
                            entry.Tracer = line
                        end

                        local rootPos, onScreen = cam:WorldToViewportPoint(root.Position)
                        if onScreen then
                            local originPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                            if espCfg.TracerOrigin == "Center" then
                                originPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                            elseif espCfg.TracerOrigin == "Mouse" then
                                originPos = UserInputService:GetMouseLocation()
                            end
                            entry.Tracer.From = originPos
                            entry.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                            entry.Tracer.Color = tracerColor
                            entry.Tracer.Visible = true
                        else
                            entry.Tracer.Visible = false
                        end
                    elseif entry.Tracer then
                        entry.Tracer.Visible = false
                    end
                else
                    local entry = Runtime.ESP.objects[p]
                    if entry then
                        if entry.Highlight then entry.Highlight.Enabled = false end
                        if entry.Billboard then entry.Billboard.Enabled = false end
                        if entry.Tracer then entry.Tracer.Visible = false end
                    end
                end
            end
        end)
    end
end

