			local ratio = barFill.Size.X.Scale
			percentLabel.Text = string.format("%d%%", math.floor(ratio * 100 + 0.5))
			if ratio >= 1 and percentLabel.TextColor3 ~= RATAHUB_LOADER_COLORS.Accent then
