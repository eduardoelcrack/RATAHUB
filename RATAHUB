-- -----------------------------------------------------------------
-- 9. TARGET SERVER PLAYER JOIN LOGIC
-- -----------------------------------------------------------------
local function JoinTargetServer(targetPlayers)
    local HttpService = Services.HttpService
    local TeleportService = Services.TeleportService
    local placeId = game.PlaceId
    local cursor = ""
    local foundServer = nil

    notify("Server", "Buscando servidor con " .. tostring(targetPlayers) .. " jugadores...")

    task.spawn(function()
        local count = 0
        repeat
            count = count + 1
            local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s", placeId, (cursor ~= "" and "&cursor=" .. cursor or ""))
            local success, res = pcall(function() return game:HttpGet(url) end)
            if success and res then
                local data = HttpService:JSONDecode(res)
                if data and data.data then
                    for _, server in ipairs(data.data) do
                        if server.playing == targetPlayers and server.id ~= game.JobId then
                            foundServer = server.id
                            break
                        end
                    end
                    cursor = data.nextPageCursor or ""
                else
                    break
                end
            else
                break
            end
        until foundServer or cursor == "" or count >= 10

        if foundServer then
            notify("Server", "Uniéndose al servidor encontrado...")
            TeleportService:TeleportToPlaceInstance(placeId, foundServer)
        else
            notify("Server", "No se encontró servidor con " .. tostring(targetPlayers) .. " jugadores")
        end
    end)
end

