		-- ------------------------------------------------------------
		-- API pública
		-- ------------------------------------------------------------
		function Loader:SetProgress(value: number)
			if self._state ~= "Loading" then
				return
			end
			value = math.clamp(value, 0, 1)

			if self._progressTween then
				self._progressTween:Cancel()
			end

			-- La duración es proporcional al salto: se nota claramente
			-- cómo la barra recorre el camino hasta el nuevo valor en
			-- lugar de saltar de golpe.
			local currentRatio = barFill.Size.X.Scale
			local delta = math.abs(value - currentRatio)
			local duration = math.clamp(delta * 2.8, 0.8, 3.6)

			local tween = TweenService:Create(
				barFill,
				TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ Size = UDim2.new(value, 0, 1, 0) }
			)
			self._progressTween = tween
			tween:Play()

			-- Glow del borde del panel: entre más avanza el progreso, el
			-- borde de acento se vuelve más opaco, más grueso y más
			-- brillante (se acerca a blanco). Va sincronizado con la
			-- misma duración que la barra para que se sienta como una
			-- sola cosa.
			if self._glowTween then
				self._glowTween:Cancel()
			end
			local glowTransparency = 0.75 - (0.7 * value)
			local glowThickness = 1 + (1.6 * value)
			local glowColor = RATAHUB_LOADER_COLORS.Accent:Lerp(Color3.fromRGB(200, 232, 255), value)
			local glowTween = TweenService:Create(
				panelStroke,
				TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ Transparency = glowTransparency, Thickness = glowThickness, Color = glowColor }
			)
			self._glowTween = glowTween
			glowTween:Play()
		end

		function Loader:SetStatus(text: string)
			if self._state ~= "Loading" then
				return
			end

			if self._statusTween then
				self._statusTween:Cancel()
			end

			local fadeOut = TweenService:Create(
				status,
				TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ TextTransparency = 1 }
			)
			self._statusTween = fadeOut
			fadeOut:Play()

			fadeOut.Completed:Once(function()
				-- Aunque Finish() ya haya entrado en "Finishing", dejamos
				-- que este fade termine su ciclo (fade-in incluido) para
				-- que el texto nunca se quede pegado en invisible. Solo
				-- abortamos si el Loader ya fue destruido del todo.
				if self._state == "Destroyed" then
					return
				end
				self._statusBase = text
				status.Text = text
				local fadeIn = TweenService:Create(
					status,
					TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextTransparency = 0.15 }
				)
				self._statusTween = fadeIn
				fadeIn:Play()
			end)
		end

		-- ------------------------------------------------------------
		-- Finish(): no bloquea el script que lo llama.
		-- Respeta el tiempo mínimo visible desde la creación y luego
		-- ejecuta, en aprox. 0.8-1.2s: Ready -> 100% -> Fade Out -> Destroy.
		-- ------------------------------------------------------------
		function Loader:Finish()
			if self._state ~= "Loading" then
				return
			end
			self._state = "Finishing"

			task.spawn(function()
				local elapsed = os.clock() - self._createdAt
				local remaining = RATAHUB_LOADER_MIN_VISIBLE_TIME - elapsed
				if remaining > 0 then
					task.wait(remaining)
				end

				-- Si la barra todavía está en movimiento hacia el valor
				-- que le mandaron por SetProgress, la dejamos terminar su
				-- propio recorrido en vez de cortarla a medias: cancelarla
				-- a mitad de camino y arrancar otra tween más corta es lo
				-- que se sentía como un "impulso" repentino de velocidad.
				if self._progressTween and self._progressTween.PlaybackState == Enum.PlaybackState.Playing then
					self._progressTween.Completed:Wait()
				end

				-- Detiene todo lo ambiental/entrada/estado.
				for _, tween in ipairs(self._entranceTweens) do
					pcall(function()
						tween:Cancel()
					end)
				end
				for _, tween in ipairs(self._ambientTweens) do
					pcall(function()
						tween:Cancel()
					end)
				end
				if self._progressTween then
					self._progressTween:Cancel()
				end
				if self._glowTween then
					self._glowTween:Cancel()
				end
				if self._statusTween then
					self._statusTween:Cancel()
				end

				-- El texto cambia de ancho al pasar a "Ready" (string más
				-- corto). Para que ese reacomodo del layout no se note,
				-- lo hacemos desaparecer, lo cambiamos mientras es
				-- invisible, y lo regresamos ya en su posición final.
				local readyFadeOut = TweenService:Create(
					status,
					TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextTransparency = 1 }
				)
				self._statusTween = readyFadeOut
				readyFadeOut:Play()
				readyFadeOut.Completed:Wait()

				self._statusBase = "Ready"
				status.Text = "Ready"

				local readyFadeIn = TweenService:Create(
					status,
					TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextTransparency = 0 }
				)
				self._statusTween = readyFadeIn
				readyFadeIn:Play()

				-- El spinner ya cumplió su función: en vez de quedarse
				-- congelado a medio giro (se ve como un anillo roto),
				-- se desvanece limpio apenas entramos a "Ready".
				TweenService:Create(
					spinnerStroke,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Transparency = 1 }
				):Play()

				local completeDelta = math.abs(1 - barFill.Size.X.Scale)
				local completeDuration = math.clamp(completeDelta * 1.1, 0.2, 0.45)
				local completeTween = TweenService:Create(
					barFill,
					TweenInfo.new(completeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Size = UDim2.new(1, 0, 1, 0) }
				)
				completeTween:Play()
				completeTween.Completed:Wait()

				TweenService:Create(percentLabel, TweenInfo.new(0.2), { TextColor3 = RATAHUB_LOADER_COLORS.Accent }):Play()

				task.wait(0.15)

				-- Fade Out + Scale Out de cada elemento, en paralelo.
				local fadeDuration = 0.32
				local fadeTargets: { Tween } = {
					TweenService:Create(backdrop, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(shadow, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(panel, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(panelStroke, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }),
					TweenService:Create(uiScale, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.92 }),
					TweenService:Create(title, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }),
					TweenService:Create(badge, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(badgeStroke, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }),
					TweenService:Create(badgeText, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }),
					TweenService:Create(divider, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(status, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }),
					TweenService:Create(spinnerStroke, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }),
					TweenService:Create(barBg, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(barFill, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(percentLabel, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }),
				}

				for _, tween in ipairs(fadeTargets) do
					tween:Play()
				end
				fadeTargets[1].Completed:Wait()

				-- Destruir el loader primero
				self:Destroy()

				-- Mostrar la GUI principal después de que el loader terminó
				local mainGui = nil

				pcall(function()
					mainGui = PlayerGui:FindFirstChild("RATAHUBGui")
				end)

				if not mainGui then
					pcall(function()
						if gethui then
							local hui = gethui()
							if hui then
								mainGui = hui:FindFirstChild("RATAHUBGui")
							end
						end
					end)
				end

				if not mainGui then
					pcall(function()
						mainGui = game:GetService("CoreGui"):FindFirstChild("RATAHUBGui")
					end)
				end

				if mainGui and mainGui:IsA("ScreenGui") then
					mainGui.Enabled = true

					-- Forzar un frame para que Roblox recalcule el layout
					task.defer(function()
						if mainGui and mainGui.Parent then
							mainGui.Enabled = false
							task.wait()
							mainGui.Enabled = true
						end
					end)
				end
			end)
		end

		function Loader:Destroy()
			if self._state == "Destroyed" then
				return
			end
			self._state = "Destroyed"

			if self._progressTween then
				pcall(function()
					self._progressTween:Cancel()
				end)
			end
			if self._glowTween then
				pcall(function()
					self._glowTween:Cancel()
				end)
			end
			if self._statusTween then
				pcall(function()
					self._statusTween:Cancel()
				end)
			end
			for _, tween in ipairs(self._entranceTweens) do
				pcall(function()
					tween:Cancel()
				end)
			end
			for _, tween in ipairs(self._ambientTweens) do
				pcall(function()
					tween:Cancel()
				end)
			end
			table.clear(self._entranceTweens)
			table.clear(self._ambientTweens)

			for _, connection in ipairs(self._connections) do
				if connection.Connected then
					connection:Disconnect()
				end
			end
			table.clear(self._connections)

			for _, instance in ipairs(self._ambientInstances) do
				pcall(function()
					instance:Destroy()
				end)
			end
			table.clear(self._ambientInstances)

			if screenGui.Parent then
				screenGui:Destroy()
			end
		end

		return Loader
	end

