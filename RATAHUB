function Features.GetAimPart(char)
    if not char then return nil end
    local aimPart = Config.Aimlock.AimPart or "Head"

    if aimPart == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
    elseif aimPart == "Torso" then
        return char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChildWhichIsA("BasePart")
    else
        for _, name in ipairs({"Head", "UpperTorso", "Torso", "HumanoidRootPart"}) do
            local p = char:FindFirstChild(name)
            if p then return p end
        end
        return char:FindFirstChildWhichIsA("BasePart")
    end
end

local function ClearAimlockHighlight()
    if Runtime.Aimlock.highlight then
        pcall(function() Runtime.Aimlock.highlight:Destroy() end)
        Runtime.Aimlock.highlight = nil
    end
end

local function CreateAimlockHighlight(plr)
    ClearAimlockHighlight()
    if not plr or not plr.Character then return end

    local h = Instance.new("Highlight")
    h.Name = "AimlockESP"
    h.Adornee = plr.Character
    h.FillColor = Color3.fromRGB(255, 0, 0)
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = plr.Character
    Runtime.Aimlock.highlight = h
end

function Features.FindBestAimlockTarget()
    local aimCfg = Config.Aimlock
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local closestPlayer = nil
    local shortest = math.huge
    local rawMouse = UserInputService:GetMouseLocation()
    local mousePos = Vector2.new(rawMouse.X, rawMouse.Y)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player
            and Features.IsAlive(plr)
            and Features.IsWhitelisted(plr, aimCfg.WhitelistMode, aimCfg.WhitelistTarget)
        then
            if aimCfg.FriendCheck and Features.IsFriend(plr) then continue end

            if aimCfg.WhitelistMode ~= "Only Whitelist" then
                if aimCfg.TeamCheck and Features.IsSameTeam(plr) then continue end
                if Features.IsTeamIgnored(plr, aimCfg.IgnoreTeams) then continue end
            end

            local char = plr.Character
            if not char then continue end
            local part = Features.GetAimPart(char)
            if not part then continue end

            local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
            if not onScreen then continue end

            local worldDist = (cam.CFrame.Position - part.Position).Magnitude
            if aimCfg.UseMaxDistance and worldDist > aimCfg.MaxDistance then continue end

            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if aimCfg.UseFOV and aimCfg.FOVSize and dist > aimCfg.FOVSize then continue end

            local priority = aimCfg.TargetPriority or "Closest to Mouse"
            local score = dist
            if priority == "Distance" then
                score = worldDist
            elseif priority == "Low Health" then
                local hum = char:FindFirstChildOfClass("Humanoid")
                score = hum and hum.Health or 100
            end

            if score < shortest then
                shortest = score
                closestPlayer = plr
            end
        end
    end
    return closestPlayer
end

function Features.UnlockAimlock(reason, targetName)
    Runtime.Aimlock.locked = false
    Runtime.Aimlock.currentTarget = nil
    ClearAimlockHighlight()
    if Runtime.Aimlock.tracer then Runtime.Aimlock.tracer.Visible = false end

    if reason == "died" and targetName then
        RATAHUB:Notify({ Title = "☠️", Content = targetName .. " eliminated", Duration = 2 })
    elseif reason == "left" and targetName then
        RATAHUB:Notify({ Title = "Aimlock", Content = targetName .. " left / despawned", Duration = 1.5 })
    end
end

function Features.ToggleAimlockLock()
    if not Config.Aimlock.Enabled then return end
    if Runtime.Aimlock.locked then
        Features.UnlockAimlock()
        Features.ClearLastTarget("aimlock")
        RATAHUB:Notify({ Title = "Aimlock", Content = "Paused", Duration = 1.2 })
    else
        local candidate = Features.FindBestAimlockTarget()
        if candidate then
            Runtime.Aimlock.currentTarget = candidate
            Runtime.Aimlock.locked = true
            CreateAimlockHighlight(candidate)
            Features.SetLastTarget(candidate, "aimlock")
            if Config.Sounds.LockSound and Config.Sounds.LockTargetSound then
                Features.PlaySound(Config.Sounds.LockTargetSound)
            end
            RATAHUB:Notify({ Title = "Aimlock", Content = "Locked onto " .. candidate.Name, Duration = 1.5 })
        else
            RATAHUB:Notify({ Title = "Aimlock", Content = "No target in range to lock", Duration = 1.5 })
        end
    end
end

function Features.UpdateAimlock()
    local aimCfg = Config.Aimlock
    if not aimCfg.Enabled then
        if Runtime.Aimlock.loop then
            Runtime.Aimlock.loop:Disconnect()
            Runtime.Aimlock.loop = nil
        end
        Features.UnlockAimlock()
        return
    end

    if not Runtime.Aimlock.loop then
        Runtime.Aimlock.loop = RunService.RenderStepped:Connect(function()
            if not Config.Aimlock.Enabled or not Runtime.Aimlock.locked or not Runtime.Aimlock.currentTarget then
                if Runtime.Aimlock.tracer then Runtime.Aimlock.tracer.Visible = false end
                return
            end

            local targetPlayer = Runtime.Aimlock.currentTarget
            local targetName = targetPlayer.Name

            if not targetPlayer.Parent then
                Features.UnlockAimlock("left", targetName)
                return
            end
            if not Features.IsAlive(targetPlayer) then
                Features.PlaySound("CS:GO Headshot")
                Features.UnlockAimlock("died", targetName)
                return
            end
            if not Features.IsWhitelisted(targetPlayer, Config.Aimlock.WhitelistMode, Config.Aimlock.WhitelistTarget) then
                Features.UnlockAimlock()
                return
            end

            local char = targetPlayer.Character
            if not char then
                Features.UnlockAimlock("left", targetName)
                return
            end

            local part = Features.GetAimPart(char)
            local root = char:FindFirstChild("HumanoidRootPart")
            if not part then
                Features.UnlockAimlock("left", targetName)
                return
            end

            local cam = workspace.CurrentCamera
            if not cam then return end

            local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
            local worldDist = (part.Position - cam.CFrame.Position).Magnitude

            local smoothness = tonumber(Config.Aimlock.Smoothness) or 100
            local isMaxSmooth = smoothness >= 100

            if Config.Aimlock.UseMaxDistance and worldDist > Config.Aimlock.MaxDistance then
                Features.UnlockAimlock()
                RATAHUB:Notify({ Title = "Aimlock", Content = "Target out of range", Duration = 1.5 })
                return
            end

            local isMouseLock = (Config.Aimlock.LockType or "Camera Lock") == "Mouse Lock"
            if isMouseLock then
                if not onScreen or screenPos.Z <= 0 then
                    Features.UnlockAimlock()
                    RATAHUB:Notify({ Title = "Aimlock", Content = "Target out of range", Duration = 1.5 })
                    return
                end
            else
                if not onScreen and not isMaxSmooth then
                    Features.UnlockAimlock()
                    RATAHUB:Notify({ Title = "Aimlock", Content = "Target out of range", Duration = 1.5 })
                    return
                end
            end

            local targetPos = part.Position
            if Config.Aimlock.Prediction and root then
                local vel = root.AssemblyLinearVelocity or Vector3.zero
                targetPos = targetPos + (vel * Config.Aimlock.PredictionTime)
            end

            if isMouseLock then
                local screenTarget, onScreenTarget = cam:WorldToViewportPoint(targetPos)
                if onScreenTarget and screenTarget.Z > 0 then
                    local mPos = UserInputService:GetMouseLocation()
                    local deltaX = screenTarget.X - mPos.X
                    local deltaY = screenTarget.Y - mPos.Y
                    local factor = (smoothness >= 100) and 1 or math.clamp(smoothness / 100, 0.05, 1)
                    local moveX = deltaX * factor
                    local moveY = deltaY * factor
                    local maxStep = 150
                    moveX = math.clamp(moveX, -maxStep, maxStep)
                    moveY = math.clamp(moveY, -maxStep, maxStep)
                    if math.abs(deltaX) < 1 then moveX = 0 end
                    if math.abs(deltaY) < 1 then moveY = 0 end
                    if moveX ~= 0 or moveY ~= 0 then
                        if mousemoverel then
                            mousemoverel(moveX, moveY)
                        elseif mousemoveabs then
                            mousemoveabs(mPos.X + moveX, mPos.Y + moveY)
                        end
                    end
                else
                    Features.UnlockAimlock()
                    RATAHUB:Notify({ Title = "Aimlock", Content = "Target out of range", Duration = 1.5 })
                    return
                end
            else
                local targetCF = CFrame.lookAt(cam.CFrame.Position, targetPos)
                local smoothVal = Config.Aimlock.Smoothness
                if type(smoothVal) == "number" then
                    if smoothVal > 1 then
                        smoothVal = math.clamp(smoothVal / 100, 0.01, 1)
                    else
                        smoothVal = math.clamp(smoothVal, 0.01, 1)
                    end
                else
                    smoothVal = 1
                end
                cam.CFrame = cam.CFrame:Lerp(targetCF, smoothVal)
            end

            if Runtime.Aimlock.highlight and Runtime.Aimlock.highlight.Adornee ~= char then
                CreateAimlockHighlight(targetPlayer)
            end
            if Runtime.Aimlock.tracer then Runtime.Aimlock.tracer.Visible = false end
        end)
    end
end

