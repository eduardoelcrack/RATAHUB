        end

        -- CreateParagraph
        function sectionWrapper:CreateParagraph(cfg)
            cfg = cfg or {}
            local borosLabel = self._borosSection:label({
                name    = tostring(cfg.Title or "Paragraph") .. "\n" .. tostring(cfg.Content or ""),
                wrapped = true,
            })
            return {
                _boros = borosLabel,
                SetTitle   = function(_, t) end,
                SetContent = function(_, t) borosLabel.set(t) end,
                Set = function(_, t) borosLabel.set(t) end,
