function Features.RestoreDeletedMapParts()
    local count = 0
    for i = #DeletedPartsCache, 1, -1 do
        local data = DeletedPartsCache[i]
        if data and data.Clone then
            local s = pcall(function()
                data.Clone.CFrame = data.CFrame
                local targetParent = data.OriginalParent
                if not targetParent or not targetParent.Parent then
                    targetParent = workspace
                end
                data.Clone.Parent = targetParent
            end)
            if s then count = count + 1 end
        end
    end
    table.clear(DeletedPartsCache)
    if count > 0 then
        RATAHUB:Notify({ Title = "BTools", Content = string.format("Restored %d map parts/walls", count), Duration = 2 })
    else
        RATAHUB:Notify({ Title = "BTools", Content = "No parts to restore", Duration = 1.5 })
    end
end

