            end

            local Data = {
                name = Name,
                faces = {
                    {
                        name = "Normal",
                        weight = Weight,
                        style = Style,
                        assetId = (getcustomasset and isfile and isfile(Asset.Id)) and getcustomasset(Asset.Id) or "",
                    },
                },
            }
            if writefile then
                writefile(Name .. ".font", Services.HttpService:JSONEncode(Data))
            end
        end)

        if getcustomasset and isfile and isfile(Name .. ".font") then
            local ok, fontAsset = pcall(getcustomasset, Name .. ".font")
            if ok and fontAsset then return fontAsset end
