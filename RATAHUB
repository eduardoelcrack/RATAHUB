local function getEquippedWeapon(plr)
    if not plr or not plr.Character then return nil end
    for _, item in ipairs(plr.Character:GetChildren()) do
        if item:IsA("Tool") and item.Name and item.Name ~= "" then
            return item.Name
        end
    end
    return nil
end

local function formatServerTime()
    local t = math.floor(workspace.DistributedGameTime or 0)
    local hrs  = math.floor(t / 3600)
    local mins = math.floor((t % 3600) / 60)
    local secs = t % 60
    if hrs > 0 then
        return string.format("%02d:%02d:%02d", hrs, mins, secs)
    else
        return string.format("%02d:%02d", mins, secs)
    end
end

local hudFrameCounter = 0
local hudLastTime     = os.clock()
local hudFPS          = 0
local hudAccumulator  = 0
local HUD_UPDATE_RATE = 0.10

Runtime.HUD.loop = RunService.RenderStepped:Connect(function(dt)
    hudFrameCounter += 1
    local now = os.clock()
    if now - hudLastTime >= 0.5 then
        hudFPS = math.floor(hudFrameCounter / (now - hudLastTime) + 0.5)
        hudFrameCounter = 0
        hudLastTime = now
    end

    hudAccumulator += dt
    if hudAccumulator < HUD_UPDATE_RATE then return end
    hudAccumulator = 0

    local ping = 0
    pcall(function() ping = math.floor(player:GetNetworkPing() * 1000 + 0.5) end)

    local maxPlrs = Players.MaxPlayers
    if not maxPlrs or maxPlrs <= 0 then maxPlrs = 20 end
    local currPlrs = #Players:GetPlayers()

    if statLabels.FPS and statLabels.FPS.Visible then
        statLabels.FPS.Text = string.format("FPS: %d", hudFPS)
    end
    if statLabels.Ping and statLabels.Ping.Visible then
        statLabels.Ping.Text = string.format("Ping: %d ms", ping)
    end
    if statLabels.Time and statLabels.Time.Visible then
        statLabels.Time.Text = string.format("Time: %s", formatServerTime())
    end
    if statLabels.Players and statLabels.Players.Visible then
        statLabels.Players.Text = string.format("Players: %d/%d", currPlrs, maxPlrs)
    end

    local target = nil
    local src = Runtime.LastTarget.source
    if src == "aimlock" then
        target = Runtime.Aimlock.currentTarget
    elseif src == "silent" then
        target = (SilentAim and SilentAim.LockedTarget)
            or (DaHoodSilent and DaHoodSilent.LockedTarget)
            or Runtime.LastTarget.player
    end

    local targetCfg = Config.Settings and Config.Settings.TargetInfo

    if not targetCfg or not targetCfg.Enabled or not target or not target.Parent then
        HideTargetInfo()
        return
    end

    local character = target.Character
    local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
    local root      = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        HideTargetInfo()
        return
    end

    local distance = 0
    local camera = workspace.CurrentCamera
    if camera then
        distance = math.floor((camera.CFrame.Position - root.Position).Magnitude + 0.5)
    end

    local hp        = math.max(0, humanoid.Health)
    local maxHp     = math.max(1, humanoid.MaxHealth)
    local hpPercent = math.clamp(hp / maxHp, 0, 1)

    local teamName  = target.Team and target.Team.Name or "None"
    local teamColor = Color3.fromRGB(150, 160, 173)
    if target.Team and target.Team.TeamColor then
        teamColor = target.Team.TeamColor.Color
    end

    local equippedWep = getEquippedWeapon(target) or "None"
    local aimPart     = tostring(Config.Aimlock.AimPart or "Head")

    targetName.Text = "TARGET  •  " .. target.DisplayName

    local statsLines = {}
    if targetCfg.Distance then
        table.insert(statsLines, "Dist: " .. distance .. " studs")
    end
    if targetCfg.Weapon then
        table.insert(statsLines, "Weapon: " .. equippedWep)
    end    if targetCfg.Target then
        table.insert(statsLines, "Target: " .. aimPart)
    end

    local currentY = 28
    if #statsLines > 0 then
        targetStats.Visible = true
        targetStats.Text = table.concat(statsLines, "\n")
        local statsHeight = #statsLines * 15
        targetStats.Position = UDim2.fromOffset(12, currentY)
        targetStats.Size = UDim2.new(1, -24, 0, statsHeight)
        currentY = currentY + statsHeight + 6
    else
        targetStats.Visible = false
        targetStats.Text = ""
    end

    if targetCfg.Team then
        targetTeam.Visible = true
        teamBar.Visible = true
        targetTeam.Text = "Team: " .. teamName
        targetTeam.TextColor3 = teamColor
        teamBar.BackgroundColor3 = teamColor
        targetTeam.Position = UDim2.fromOffset(12, currentY)
        targetTeam.Size = UDim2.new(1, -24, 0, 16)
        teamBar.Position = UDim2.fromOffset(12, currentY + 18)
        teamBar.Size = UDim2.fromOffset(105, 5)
        currentY = currentY + 18 + 5 + 8
    else
        targetTeam.Visible = false
        teamBar.Visible = false
    end

    hpBackground.Position = UDim2.fromOffset(12, currentY)
    hpBackground.Size = UDim2.new(1, -24, 0, 20)
    currentY = currentY + 20 + 12

    targetInfo.Size = UDim2.fromOffset(230, currentY)

    hpText.Text = string.format(
        "%d / %d  •  %d%%",
        math.floor(hp + 0.5),
        math.floor(maxHp + 0.5),
        math.floor(hpPercent * 100 + 0.5)
    )

    if math.abs(hpFill.Size.X.Scale - hpPercent) > 0.005 then
        hpFill.Size = UDim2.new(hpPercent, 0, 1, 0)
    end

    if hpPercent <= 0.25 then
        hpFill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    elseif hpPercent <= 0.55 then
        hpFill.BackgroundColor3 = Color3.fromRGB(220, 180, 50)
    else
        hpFill.BackgroundColor3 = Color3.fromRGB(65, 205, 95)
    end

    ShowTargetInfo()
end)

