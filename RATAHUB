            }
        end

        -- CreateDivider
        function sectionWrapper:CreateDivider()
            local borosLabel = self._borosSection:label({ name = "" })
            local frame = borosLabel.items.name
            frame.Size = UDim2.new(1, 0, 0, 1)
            frame.BackgroundColor3 = Color3.fromRGB(36, 36, 36)
            frame.BackgroundTransparency = 0
            return { Instance = frame }
        end

        table.insert(self._sections, sectionWrapper)
        self._currentSection = sectionWrapper
        return sectionWrapper
    end

    self._tabs[name] = tabWrapper
    table.insert(self._tabs, tabWrapper)
    return tabWrapper
