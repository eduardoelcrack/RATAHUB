--=====================================================================
-- SYNC MANAGER
--=====================================================================
local SyncManager = {
    isSyncing = false,
    snapshots = {},
}

local function cloneVal(val)
    if type(val) == "table" then
        local copy = {}
        for k, v in pairs(val) do copy[k] = v end
        return copy
    end
    return val
end

function SyncManager.SyncProperty(sourceModule, propName, value)
    if SyncManager.isSyncing then return end
    SyncManager.isSyncing = true

    local targets = {}
    if sourceModule == "ESP" then
        if Config.ESP.SyncAimlock then table.insert(targets, "Aimlock") end
        if Config.ESP.SyncTriggerbot then table.insert(targets, "Triggerbot") end
        if Config.ESP.SyncSilent then table.insert(targets, "Silent") end
    elseif sourceModule == "Aimlock" then
        if Config.Aimlock.SyncESP then table.insert(targets, "ESP") end
        if Config.Aimlock.SyncTriggerbot then table.insert(targets, "Triggerbot") end
    elseif sourceModule == "Triggerbot" then
        if Config.Triggerbot.SyncESP then table.insert(targets, "ESP") end
        if Config.Triggerbot.SyncAimlock then table.insert(targets, "Aimlock") end
    elseif sourceModule == "Silent" then
        if Config.Silent.SyncESP then table.insert(targets, "ESP") end
    end

    for _, targetMod in ipairs(targets) do
        local tCfg = Config[targetMod]
        if tCfg and tCfg[propName] ~= nil then
            tCfg[propName] = cloneVal(value)
            if Controls[targetMod] and Controls[targetMod][propName]
                and Controls[targetMod][propName].SetSilent then
                Controls[targetMod][propName]:SetSilent(value)
            end
        end

        if targetMod == "ESP" then
            Features.UpdateESP()
        elseif targetMod == "Aimlock" then
            if Runtime.Aimlock.locked and Runtime.Aimlock.currentTarget then
                if not Features.IsWhitelisted(Runtime.Aimlock.currentTarget, Config.Aimlock.WhitelistMode, Config.Aimlock.WhitelistTarget) then
                    Features.UnlockAimlock()
                end
            end
        end
    end

    SyncManager.isSyncing = false
end

function SyncManager.OnSyncToggled(sourceModule, targetModule, enabled)
    if SyncManager.isSyncing then return end
    SyncManager.isSyncing = true

    local key = sourceModule .. "->" .. targetModule
    local sCfg = Config[sourceModule]
    local tCfg = Config[targetModule]

    local propsToSync = { "WhitelistMode", "WhitelistTarget", "IgnoreTeams", "TeamCheck", "FriendCheck" }

    if enabled then
        local snapshot = {}
        if tCfg then
            for _, p in ipairs(propsToSync) do
                if tCfg[p] ~= nil then snapshot[p] = cloneVal(tCfg[p]) end
            end
        end
        SyncManager.snapshots[key] = snapshot

        if sCfg and tCfg then
            for _, p in ipairs(propsToSync) do
                if sCfg[p] ~= nil and tCfg[p] ~= nil then
                    tCfg[p] = cloneVal(sCfg[p])
                    if Controls[targetModule] and Controls[targetModule][p]
                        and Controls[targetModule][p].SetSilent then
                        Controls[targetModule][p]:SetSilent(sCfg[p])
                    end
                end
            end
        end
    else
        local snapshot = SyncManager.snapshots[key]
        if snapshot and tCfg then
            for _, p in ipairs(propsToSync) do
                if snapshot[p] ~= nil then
                    tCfg[p] = cloneVal(snapshot[p])
                    if Controls[targetModule] and Controls[targetModule][p]
                        and Controls[targetModule][p].SetSilent then
                        Controls[targetModule][p]:SetSilent(snapshot[p])
                    end
                end
            end
            SyncManager.snapshots[key] = nil
        end
    end

    if targetModule == "ESP" then
        Features.UpdateESP()
    elseif targetModule == "Aimlock" then
        if Runtime.Aimlock.locked and Runtime.Aimlock.currentTarget then
            if not Features.IsWhitelisted(Runtime.Aimlock.currentTarget, Config.Aimlock.WhitelistMode, Config.Aimlock.WhitelistTarget) then
                Features.UnlockAimlock()
            end
        end
    end

    SyncManager.isSyncing = false
end

Features.SyncManager = SyncManager

