        }

        -- CreateToggle
        function sectionWrapper:CreateToggle(cfg)
            cfg = cfg or {}
            local initial = cfg.CurrentValue == true

            local borosToggle = self._borosSection:toggle({
                name     = cfg.Name or "Toggle",
                info     = cfg.Description,
                default  = initial,
                callback = function(value)
                    if cfg.Callback then pcall(cfg.Callback, value) end
                end,
            })

            local wrapper = {
                _boros = borosToggle,
                Set = function(_, value)
                    borosToggle.enabled = value and true or false
                    borosToggle.set(borosToggle.enabled)
                end,
                Get = function(_) return borosToggle.enabled end,
                SetSilent = function(_, value)
                    value = value and true or false
                    borosToggle.enabled = value
                    BOROS:tween(borosToggle.items.toggle_button, {BackgroundColor3 = value and themes.preset.accent or rgb(58,58,62)}, Enum.EasingStyle.Quad)
                    BOROS:tween(borosToggle.items.inline, {BackgroundColor3 = value and themes.preset.accent or rgb(50,50,50)}, Enum.EasingStyle.Quad)
