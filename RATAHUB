-- Helpers
local function keyToString(key)
    if key == nil then return "None" end
    if typeof(key) == "EnumItem" then return key.Name end
    if type(key) == "string" then return key end
    return tostring(key)
end

local function stringToKey(str)
    if not str or str == "None" or str == "" then return nil end
    if typeof(str) == "EnumItem" then return str end
    local ok, code = pcall(function() return Enum.KeyCode[str] end)
    if ok and code then return code end
    return nil
end

