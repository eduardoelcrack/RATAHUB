function Features.SetUnlockMaxDistance(enabled)
    if enabled then
        Runtime.Camera.savedMaxZoom = player.CameraMaxZoomDistance
        player.CameraMaxZoomDistance = 99999
    else
        player.CameraMaxZoomDistance = Runtime.Camera.savedMaxZoom or 128
    end
end

function Features.SetFOVChanger(enabled)
    if enabled then
        Runtime.Camera.savedFOV = workspace.CurrentCamera.FieldOfView
        if not Runtime.Camera.fovLoop then
            Runtime.Camera.fovLoop = RunService.RenderStepped:Connect(function()
                if Config.Extras.Camera.FOVChanger then
                    workspace.CurrentCamera.FieldOfView = Config.Extras.Camera.FOV
                end
            end)
        end
    else
        if Runtime.Camera.fovLoop then
            Runtime.Camera.fovLoop:Disconnect()
            Runtime.Camera.fovLoop = nil
        end
        workspace.CurrentCamera.FieldOfView = Runtime.Camera.savedFOV or 70
    end
end

function Features.SetFreecam(enabled)
    local cam  = workspace.CurrentCamera
    local root = getRoot()
    if not cam then return end

    if enabled then
        Runtime.Camera.savedType    = cam.CameraType
        Runtime.Camera.savedSubject = cam.CameraSubject
        cam.CameraType = Enum.CameraType.Scriptable
        if root then
            Runtime.Camera.wasAnchored = root.Anchored
            root.Anchored = true
        end

        Runtime.Camera.freecamBegan = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                Runtime.Camera.keys[input.KeyCode] = true
            end
        end)
        Runtime.Camera.freecamEnded = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                Runtime.Camera.keys[input.KeyCode] = nil
            end
        end)

        Runtime.Camera.freecamLoop = RunService.RenderStepped:Connect(function()
            local speed = Config.Extras.Camera.FreecamSpeed or 10
            local dir   = Vector3.zero
            local keys  = Runtime.Camera.keys

            if keys[Enum.KeyCode.W] then dir = dir + cam.CFrame.LookVector end
            if keys[Enum.KeyCode.S] then dir = dir - cam.CFrame.LookVector end
            if keys[Enum.KeyCode.A] then dir = dir - cam.CFrame.RightVector end
            if keys[Enum.KeyCode.D] then dir = dir + cam.CFrame.RightVector end
            if keys[Enum.KeyCode.E] then dir = dir + Vector3.new(0, 1, 0) end
            if keys[Enum.KeyCode.Q] then dir = dir - Vector3.new(0, 1, 0) end

            if dir.Magnitude > 0 then
                cam.CFrame = cam.CFrame + (dir.Unit * (speed * 0.1))
            end
        end)
    else
        if Runtime.Camera.freecamLoop then Runtime.Camera.freecamLoop:Disconnect() Runtime.Camera.freecamLoop = nil end
        if Runtime.Camera.freecamBegan then Runtime.Camera.freecamBegan:Disconnect() Runtime.Camera.freecamBegan = nil end
        if Runtime.Camera.freecamEnded then Runtime.Camera.freecamEnded:Disconnect() Runtime.Camera.freecamEnded = nil end
        table.clear(Runtime.Camera.keys)

        cam.CameraType = Runtime.Camera.savedType or Enum.CameraType.Custom
        if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            cam.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
        end
        if root and Runtime.Camera.wasAnchored ~= nil then
            root.Anchored = Runtime.Camera.wasAnchored
        end
    end
end

function Features.SetXRay(enabled)
    if enabled then
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and not part:IsDescendantOf(player.Character) and not part.Parent:FindFirstChildOfClass("Humanoid") then
                if Runtime.XRay.parts[part] == nil then
                    Runtime.XRay.parts[part] = part.Transparency
                end
                if part.Transparency < 0.5 then
                    part.Transparency = 0.5
                end
            end
        end
    else
        for part, orig in pairs(Runtime.XRay.parts) do
            if part and part.Parent then
                part.Transparency = orig
            end
        end
        table.clear(Runtime.XRay.parts)
    end
end

local function GiveClickTPTool()
    local backpack = player:FindFirstChildOfClass("Backpack")
    local char     = player.Character
    if not backpack or not char then return end
    if not backpack:FindFirstChild("Click TP") and not char:FindFirstChild("Click TP") then
        local tool = Instance.new("Tool")
        tool.RequiresHandle = false
        tool.Name = "Click TP"
        tool.ToolTip = "Click anywhere to teleport"

        tool.Activated:Connect(function()
            local mouse = player:GetMouse()
            if not mouse then return end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { player.Character }

            local unitRay = mouse.UnitRay
            local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, params)
            local targetPos = rayResult and rayResult.Position or (mouse.Hit and mouse.Hit.Position)

            if targetPos and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    player.Character:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0)))
                end
            end
        end)

        tool.Parent = backpack
    end
end

local function RemoveClickTPTool()
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack and backpack:FindFirstChild("Click TP") then
        pcall(function() backpack["Click TP"]:Destroy() end)
    end
    local char = player.Character
    if char and char:FindFirstChild("Click TP") then
        pcall(function() char["Click TP"]:Destroy() end)
    end
end

local DeletedPartsCache = {}

local function GiveBToolsTool()
    local backpack = player:FindFirstChildOfClass("Backpack")
    local char     = player.Character
    if not backpack or not char then return end
    if not backpack:FindFirstChild("BTools") and not char:FindFirstChild("BTools") then
        local tool = Instance.new("Tool")
        tool.RequiresHandle = false
        tool.Name = "BTools"
        tool.ToolTip = "Click any wall or part to delete (Client-side)"

        tool.Activated:Connect(function()
            local mouse  = player:GetMouse()
            local target = mouse and mouse.Target
            if target and target:IsA("BasePart") and not target:IsDescendantOf(player.Character) then
                local isPlayer = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and target:IsDescendantOf(p.Character) then
                        isPlayer = true
                        break
                    end
                end

                if not isPlayer and target.Parent then
                    pcall(function() target.Archivable = true end)
                    local success, clone = pcall(function() return target:Clone() end)
                    if success and clone then
                        pcall(function() clone.Archivable = true end)
                        table.insert(DeletedPartsCache, {
                            Clone = clone,
                            OriginalParent = target.Parent,
                            CFrame = target.CFrame,
                        })
                        if #DeletedPartsCache > 2000 then
                            table.remove(DeletedPartsCache, 1)
                        end
                    end
                    pcall(function() target:Destroy() end)
                end
            end
        end)

        tool.Parent = backpack
    end
end

local function RemoveBToolsTool()
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item.Name == "BTools" then pcall(function() item:Destroy() end) end
            if item:IsA("HopperBin") and (item.Name == "BTools" or item.BinType == Enum.BinType.Hammer) then pcall(function() item:Destroy() end) end
        end
    end
    local char = player.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and item.Name == "BTools" then pcall(function() item:Destroy() end) end
            if item:IsA("HopperBin") and (item.Name == "BTools" or item.BinType == Enum.BinType.Hammer) then pcall(function() item:Destroy() end) end
        end
    end
end

