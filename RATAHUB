function Features.StopFly()
    Runtime.Fly.active = false
    if Runtime.Fly.loop then Runtime.Fly.loop:Disconnect() Runtime.Fly.loop = nil end
    if Runtime.Fly.bv then Runtime.Fly.bv:Destroy() Runtime.Fly.bv = nil end
    if Runtime.Fly.bg then Runtime.Fly.bg:Destroy() Runtime.Fly.bg = nil end
    if Runtime.Fly.instances then
        for _, inst in ipairs(Runtime.Fly.instances) do pcall(function() inst:Destroy() end) end
        table.clear(Runtime.Fly.instances)
    end
    if Runtime.Fly.attachments then
        for _, att in ipairs(Runtime.Fly.attachments) do pcall(function() att:Destroy() end) end
        table.clear(Runtime.Fly.attachments)
    end
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        if Runtime.Fly.animate then
            Runtime.Fly.animate.Parent = char
            Runtime.Fly.animate = nil
        end
    end
end

function Features.StartFly()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char.HumanoidRootPart
    if hum then hum.PlatformStand = true end
    if char:FindFirstChild("Animate") then
        Runtime.Fly.animate = char.Animate:Clone()
        char.Animate:Destroy()
    end

    local method = Config.Main.Movement.FlyMethod or "BodyVelocity"
    Runtime.Fly.method = method
    Runtime.Fly.instances = {}
    Runtime.Fly.attachments = {}

    if method == "BodyVelocity" then
        Runtime.Fly.bv = Instance.new("BodyVelocity")
        Runtime.Fly.bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        Runtime.Fly.bv.Velocity = Vector3.zero
        Runtime.Fly.bv.Parent = root
        table.insert(Runtime.Fly.instances, Runtime.Fly.bv)

        Runtime.Fly.bg = Instance.new("BodyGyro")
        Runtime.Fly.bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        Runtime.Fly.bg.P = 20000
        Runtime.Fly.bg.D = 800
        Runtime.Fly.bg.Parent = root
        table.insert(Runtime.Fly.instances, Runtime.Fly.bg)
    end

    Runtime.Fly.active = true
    Runtime.Fly.loop = RunService.RenderStepped:Connect(function(dt)
        if not Runtime.Fly.active or not Config.Main.Movement.Fly then
            Features.StopFly()
            return
        end
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        local cam = workspace.CurrentCamera
        if not cam then return end

        local look  = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local move  = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + look end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - look end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end

        local speed = Config.Main.Movement.FlySpeed or 140
        local velocity = move * speed

        if method == "BodyVelocity" then
            if Runtime.Fly.bv then Runtime.Fly.bv.Velocity = velocity end
            if Runtime.Fly.bg then Runtime.Fly.bg.CFrame = cam.CFrame end
        elseif method == "AssemblyLinearVelocity" then
            hum.PlatformStand = true
            if move.Magnitude > 0 then
                root.AssemblyLinearVelocity = move.Unit * speed
            else
                root.AssemblyLinearVelocity = Vector3.zero
            end
        elseif method == "Platform Fly" then
            hum.PlatformStand = true
            root.AssemblyLinearVelocity = Vector3.zero
            if move.Magnitude > 0 then
                root.CFrame = root.CFrame + (move.Unit * speed * dt)
            end
        elseif method == "CFrame" then
            hum.PlatformStand = true
            root.AssemblyLinearVelocity = Vector3.zero
            if move.Magnitude > 0 then
                local newPos = root.Position + (move.Unit * speed * dt)
                root.CFrame = CFrame.new(newPos, newPos + look)
            else
                root.CFrame = CFrame.new(root.Position, root.Position + look)
            end
        end
    end)
end

