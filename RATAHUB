                name     = cfg.Name or "Keybind",
                key      = stringToKey(cfg.CurrentKeybind),
                mode     = "Toggle",
                callback = function(value)
                    if cfg.Callback then pcall(cfg.Callback, value) end
                end,
            })

            local wrapper = {
                _boros = borosKeybind,
                Set = function(_, k)
                    borosKeybind.set({ key = stringToKey(k), mode = "Toggle", active = false })
                end,
                Get = function(_) return borosKeybind.key end,
            }
            self._controls[cfg.Name or "keybind"] = wrapper
            return wrapper
        end

